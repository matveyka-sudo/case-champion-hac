# Local PostgreSQL. Change the port and URL together for each worktree.
POSTGRES_DB=a2
POSTGRES_USER=a2
POSTGRES_PASSWORD=a2_local_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://a2:a2_local_dev@127.0.0.1:5432/a2
# Optional; backend defaults to a2_backend if absent.
# DATABASE_SCHEMA=a2_backend

# Local API and SPA ports.
API_PORT=8000
WEB_PORT=5173

# Assistant hooks are installed in fallback mode while LIVE gates are false.
ASSISTANT_HOOK=a2_api.assistant.alice:build_assistant
ASSISTANT_BUDGET_HOOK=a2_api.assistant.budget:build_budget
ASSISTANT_TOOLS_ENABLED=false
LLM_ENABLED=false
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=aliceai-llm-flash
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# PostgreSQL DeploymentBudget: set-limit must be run explicitly after migrations.
# RUB is a local accounting assumption, not confirmed organizer billing currency.
ALICE_CURRENCY=RUB
ALICE_TARIFF_ID=aliceai-llm-flash-sync-rub-2026-11-09
ALICE_BUDGET_LIMIT=10
ALICE_TOKEN_LIMIT=50000
ALICE_BILLING_CURRENCY_CONFIRMED=false

# Optional transport inputs.
YANDEX_RASP_API_KEY=
TRAFFIC_MODE=static
