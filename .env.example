# Local PostgreSQL only. Change the port and URL together for each worktree.
POSTGRES_DB=a2
POSTGRES_USER=a2
POSTGRES_PASSWORD=a2_local_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://a2:a2_local_dev@127.0.0.1:5432/a2

# Reserved for future API, worker and SPA entrypoints.
API_PORT=8000
WEB_PORT=5173
# Backend only; Alice AI LLM Flash via Yandex AI Studio.
LLM_ENABLED=false
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=aliceai-llm-flash
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Set a deployment cost limit before enabling paid API calls.
LLM_BUDGET_RUB=
YANDEX_RASP_API_KEY=
TRAFFIC_MODE=static
