# Copy outside Git, set mode 600 and replace the paths, hashes and password.
# Set a unique demo project and an unused loopback port in this file.
COMPOSE_PROJECT_NAME=waydex-hackathon-demo
WAYDEX_HTTP_PORT=5295
WAYDEX_REVISION=REPLACE_WITH_FULL_CHECKED_COMMIT
WAYDEX_SOURCE_DIR=/absolute/path/to/clean/source
WAYDEX_DEPLOYMENT_DIR=/absolute/path/to/generated-demo/runtime
WAYDEX_PRODUCT_MANIFEST=manifest.json
WAYDEX_PRODUCT_SHA256=REPLACE_WITH_REVIEWED_MANIFEST_SHA256
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
# The demo runs without a model or provider credentials.
WAYDEX_ASSISTANT_ENV_FILE=/dev/null
