COMPOSE_PROJECT_NAME=waydex-full-geometry-1110
WAYDEX_REVISION=REPLACE_WITH_APPROVED_INTEGRATED_SOURCE_COMMIT
WAYDEX_SOURCE_DIR=/absolute/path/to/clean/integrated/source
WAYDEX_DEPLOYMENT_DIR=/absolute/path/to/exclusively/restored/runtime-bundle
WAYDEX_PRODUCT_MANIFEST=manifest.json
WAYDEX_PRODUCT_SHA256=REPLACE_WITH_APPROVED_PRODUCT_MANIFEST_SHA256
WAYDEX_CERTIFIED_MANIFEST=proof-binding.json
WAYDEX_CERTIFIED_SHA256=REPLACE_WITH_APPROVED_CERTIFIED_BINDING_SHA256
WAYDEX_BUNDLE_MANIFEST_SHA256=REPLACE_WITH_RECORDED_BUNDLE_MANIFEST_SHA256
WAYDEX_GRAPH_DIR=/absolute/path/to/exclusively/restored/runtime-bundle/graph
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
WAYDEX_HTTP_PORT=5193
# Start with the established bound; use 2g only after the measured proof replay.
WAYDEX_WORKER_MEMORY=1g
