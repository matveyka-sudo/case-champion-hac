# Fill a private copy outside Git. Keep the assigned project name stable.
COMPOSE_PROJECT_NAME=waydex-product
WAYDEX_HTTP_PORT=5294
WAYDEX_REVISION=REPLACE_WITH_FULL_CHECKED_COMMIT
WAYDEX_SOURCE_DIR=/absolute/path/to/clean/source
WAYDEX_DEPLOYMENT_DIR=/absolute/path/to/restored/runtime
WAYDEX_PRODUCT_SHA256=REPLACE_WITH_REVIEWED_RUNTIME_MANIFEST_SHA256
WAYDEX_BUNDLE_MANIFEST_SHA256=REPLACE_WITH_REVIEWED_BUNDLE_MANIFEST_SHA256
WAYDEX_WALK_EXECUTOR_SHA256=REPLACE_WITH_FINGERPRINT_FROM_BUILT_API_IMAGE
WAYDEX_CERTIFIED_SHA256=REPLACE_WITH_RUNTIME_KALININGRAD_PROOF_BINDING_SHA256
WAYDEX_GRAPH_DIR=/absolute/path/to/transfer/graphs/moscow
WAYDEX_GRAPH_BINDING_DIR=/absolute/path/to/transfer/bindings/moscow
WAYDEX_GRAPH_BINDING_SHA256=REPLACE_WITH_BINDING_SHA256
WAYDEX_WALK_ARTIFACT=moscow/artifact.json
WAYDEX_WALK_ARTIFACT_SHA256=REPLACE_WITH_RUNTIME_MOSCOW_ARTIFACT_SHA256
WAYDEX_NOVOROSSIYSK_GRAPH_DIR=/absolute/path/to/transfer/graphs/novorossiysk
WAYDEX_NOVOROSSIYSK_GRAPH_BINDING_DIR=/absolute/path/to/transfer/bindings/novorossiysk
WAYDEX_NOVOROSSIYSK_GRAPH_BINDING_SHA256=REPLACE_WITH_BINDING_SHA256
WAYDEX_NOVOROSSIYSK_PARENT_SHA256=REPLACE_WITH_BINDING_PARENT_ARTIFACT_SHA256
WAYDEX_KALININGRAD_GRAPH_DIR=/absolute/path/to/transfer/graphs/kaliningrad
WAYDEX_KALININGRAD_TRUCK_GRAPH_DIR=/absolute/path/to/transfer/graphs/kaliningrad
WAYDEX_KALININGRAD_PARENT_SHA256=REPLACE_WITH_RUNTIME_KALININGRAD_NATIVE_ARTIFACT_SHA256
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
