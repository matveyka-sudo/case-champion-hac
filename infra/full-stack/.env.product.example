COMPOSE_PROJECT_NAME=waydex-full-product-local
WAYDEX_REVISION=REPLACE_WITH_INTEGRATED_SOURCE_COMMIT
WAYDEX_SOURCE_DIR=/absolute/path/to/clean/integrated/source
WAYDEX_DEPLOYMENT_DIR=/absolute/path/to/verified/product-manifest-directory
WAYDEX_PRODUCT_MANIFEST=manifest.json
WAYDEX_PRODUCT_SHA256=REPLACE_WITH_EXACT_MANIFEST_SHA256
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
WAYDEX_HTTP_PORT=5191
