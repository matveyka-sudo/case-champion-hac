# Keep this private file outside the source checkout, mode 600.
COMPOSE_PROJECT_NAME=waydex-full-local
WAYDEX_REVISION=REPLACE_WITH_SOURCE_COMMIT
WAYDEX_SOURCE_DIR=/absolute/path/to/clean/source
WAYDEX_GRAPH_DIR=/absolute/path/to/verified/graph
WAYDEX_PARENT_ARTIFACT=/absolute/path/to/original/walk-pilot-artifact-accepted-3.json
WAYDEX_PARENT_SHA256=REPLACE_WITH_EXACT_PARENT_SHA256
WAYDEX_DEPLOYMENT_DIR=/absolute/path/to/new/deployment
WAYDEX_ARTIFACT_SHA256=REPLACE_AFTER_PREPARE
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
WAYDEX_HTTP_PORT=5190
