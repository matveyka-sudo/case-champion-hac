{
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "unknown_id",
            "incompatible_versions",
            "idempotency_conflict",
            "budget_exceeded",
            "engine_unavailable",
            "internal_error",
            "method_not_allowed",
            "job_timeout",
            "job_cancelled"
          ],
          "title": "Code",
          "type": "string"
        },
        "field_errors": {
          "items": {
            "$ref": "#/$defs/FieldError"
          },
          "title": "Field Errors",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "field_errors",
        "retryable",
        "trace_id"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "FieldError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "location": {
          "items": {
            "type": "string"
          },
          "title": "Location",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "location",
        "code",
        "message"
      ],
      "title": "FieldError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "minLength": 1,
      "title": "Bundle Id",
      "type": "string"
    },
    "code_version": {
      "minLength": 1,
      "title": "Code Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "input_hash": {
      "minLength": 1,
      "title": "Input Hash",
      "type": "string"
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "status",
    "trace_id",
    "bundle_id",
    "input_hash",
    "code_version",
    "created_at",
    "started_at",
    "finished_at",
    "run_id",
    "error"
  ],
  "title": "Job",
  "type": "object"
}
