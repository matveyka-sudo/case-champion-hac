          "default": null,
          "title": "Task Set Hash"
        }
      },
      "required": [
        "bundle_id",
        "profile_id",
        "profile_version",
        "code_version",
        "completeness_scope",
        "network_complete",
        "search_complete"
      ],
      "title": "Provenance",
      "type": "object"
