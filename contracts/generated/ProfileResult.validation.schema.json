          "type": "integer"
        },
        "search_complete": {
          "title": "Search Complete",
          "type": "boolean"
        },
        "task_set_hash": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
