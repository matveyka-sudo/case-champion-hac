    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "assumption_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumption Ids",
          "type": "array"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "constraint_results": {
          "additionalProperties": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_requested"
            ],
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Constraint Results",
          "type": "object"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "journey_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Journey Ids",
          "type": "array"
        },
        "overall_feasibility": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ],
          "title": "Overall Feasibility",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "case_id",
        "weight",
        "overall_feasibility",
        "constraint_results",
        "reason_codes",
        "journey_ids",
        "evidence_ids",
        "assumption_ids"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "CityScore": {
      "additionalProperties": false,
      "properties": {
        "origin_id": {
          "minLength": 1,
          "title": "Origin Id",
          "type": "string"
        },
        "resolved_weight_share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Resolved Weight Share",
          "type": "number"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "score_lower": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score Lower",
          "type": "number"
        },
        "score_upper": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score Upper",
          "type": "number"
        },
        "task_count": {
          "exclusiveMinimum": 0,
          "title": "Task Count",
          "type": "integer"
        }
      },
      "required": [
        "origin_id",
        "score",
        "score_lower",
        "score_upper",
        "task_count",
        "resolved_weight_share"
      ],
      "title": "CityScore",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "minLength": 1,
          "title": "Bundle Id",
          "type": "string"
        },
        "code_version": {
          "minLength": 1,
          "title": "Code Version",
          "type": "string"
        },
        "completeness_scope": {
          "minLength": 1,
