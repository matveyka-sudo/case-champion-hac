      "minLength": 1,
      "title": "Params Hash",
      "type": "string"
    },
    "profile_id": {
      "enum": [
        "regular",
        "medical",
        "intercity"
      ],
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "exclusiveMinimum": 0,
      "title": "Profile Version",
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "reason_codes": {
      "items": {
