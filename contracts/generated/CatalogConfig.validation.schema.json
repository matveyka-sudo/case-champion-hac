{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Budget",
      "type": "object"
    },
    "ProfileConfig": {
      "additionalProperties": false,
      "properties": {
        "assumption_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumption Ids",
          "type": "array"
        },
        "basis": {
          "enum": [
            "scenario",
            "verified"
          ],
          "title": "Basis",
          "type": "string"
        },
        "destination_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Destination Ids",
          "type": "array"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "half_life_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Half Life Minutes"
        },
        "horizon_hours": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Horizon Hours"
        },
        "metric_kind": {
          "enum": [
            "activity_feasibility",
            "time_decay"
          ],
          "title": "Metric Kind",
          "type": "string"
        },
        "modes": {
          "items": {
            "enum": [
              "rail",
              "bus",
              "walk"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Modes",
          "type": "array"
        },
        "profile_id": {
          "enum": [
            "regular",
            "medical",
            "intercity"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "exclusiveMinimum": 0,
          "title": "Profile Version",
          "type": "integer"
        },
        "rules": {
          "$ref": "#/$defs/TripRules"
        },
        "service_type_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Service Type Ids",
          "type": "array"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "start_times": {
          "items": {
            "format": "time",
            "type": "string"
          },
          "minItems": 1,
          "title": "Start Times",
          "type": "array"
        },
        "study_area_id": {
          "minLength": 1,
          "title": "Study Area Id",
          "type": "string"
        },
        "study_area_version": {
          "exclusiveMinimum": 0,
          "title": "Study Area Version",
          "type": "integer"
        },
        "timezone": {
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "weighting": {
          "enum": [
            "uniform",
            "explicit"
          ],
          "title": "Weighting",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "study_area_id",
        "study_area_version",
        "metric_kind",
        "start_date",
        "end_date",
        "timezone",
        "start_times",
        "destination_ids",
        "service_type_ids",
        "modes",
        "rules",
        "weighting",
        "basis",
        "assumption_ids",
        "evidence_ids",
        "half_life_minutes",
        "horizon_hours"
      ],
      "title": "ProfileConfig",
      "type": "object"
    },
    "StudyArea": {
      "additionalProperties": false,
      "properties": {
        "area_id": {
          "minLength": 1,
          "title": "Area Id",
          "type": "string"
        },
        "area_version": {
          "exclusiveMinimum": 0,
          "title": "Area Version",
          "type": "integer"
        },
        "basis": {
          "enum": [
            "scenario",
            "verified"
          ],
          "title": "Basis",
          "type": "string"
        },
        "city_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "City Ids",
          "type": "array"
        },
        "demo_city_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Demo City Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "region_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Region Ids",
          "type": "array"
        },
        "timezone": {
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "area_id",
        "area_version",
        "region_ids",
        "city_ids",
        "demo_city_ids",
        "timezone",
        "basis",
        "evidence_ids"
      ],
      "title": "StudyArea",
      "type": "object"
    },
    "TaskCase": {
      "additionalProperties": false,
      "properties": {
        "activity_basis": {
          "anyOf": [
            {
              "enum": [
                "scenario",
                "verified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Basis"
        },
        "activity_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity End"
        },
        "activity_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Start"
        },
        "arrival_buffer_max_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Buffer Max Minutes"
        },
        "arrival_buffer_min_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Buffer Min Minutes"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "destination_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Id"
        },
        "earliest_departure": {
          "format": "date-time",
          "title": "Earliest Departure",
          "type": "string"
        },
        "max_access_walk_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Access Walk Minutes"
        },
        "max_one_way_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max One Way Minutes"
        },
        "max_transfers": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Transfers"
        },
        "origin_id": {
          "minLength": 1,
          "title": "Origin Id",
          "type": "string"
        },
        "profile_id": {
          "enum": [
            "regular",
            "medical",
            "intercity"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "require_step_free": {
          "title": "Require Step Free",
          "type": "boolean"
        },
        "return_by": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return By"
        },
        "service_date": {
          "format": "date",
          "title": "Service Date",
          "type": "string"
        },
        "service_type_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Type Id"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "max_one_way_minutes",
        "max_transfers",
        "max_access_walk_minutes",
        "budget",
        "require_step_free",
        "profile_id",
        "origin_id",
        "service_date",
        "earliest_departure",
        "case_id",
        "weight"
      ],
      "title": "TaskCase",
      "type": "object"
    },
    "TaskSet": {
      "additionalProperties": false,
      "properties": {
        "assumption_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumption Ids",
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/TaskCase"
          },
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "generation_rules_hash": {
          "minLength": 1,
          "title": "Generation Rules Hash",
          "type": "string"
        },
        "profile_id": {
          "enum": [
            "regular",
            "medical",
            "intercity"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "exclusiveMinimum": 0,
          "title": "Profile Version",
          "type": "integer"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "task_set_hash": {
          "minLength": 1,
          "title": "Task Set Hash",
          "type": "string"
        }
      },
      "required": [
        "task_set_hash",
        "generation_rules_hash",
        "profile_id",
        "profile_version",
        "start_date",
        "end_date",
        "cases",
        "assumption_ids"
      ],
      "title": "TaskSet",
      "type": "object"
    },
    "TripRules": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_access_walk_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Access Walk Minutes"
        },
        "max_one_way_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max One Way Minutes"
        },
        "max_transfers": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Transfers"
        },
        "require_step_free": {
          "title": "Require Step Free",
          "type": "boolean"
        }
      },
      "required": [
        "max_one_way_minutes",
        "max_transfers",
        "max_access_walk_minutes",
        "budget",
        "require_step_free"
      ],
      "title": "TripRules",
      "type": "object"
    }
