  "additionalProperties": false,
  "properties": {
    "profiles": {
      "items": {
        "$ref": "#/$defs/ProfileConfig"
      },
      "title": "Profiles",
      "type": "array"
    },
    "study_areas": {
      "items": {
        "$ref": "#/$defs/StudyArea"
      },
      "title": "Study Areas",
      "type": "array"
    },
    "task_sets": {
      "items": {
        "$ref": "#/$defs/TaskSet"
      },
      "title": "Task Sets",
      "type": "array"
    }
  },
  "required": [
    "study_areas",
    "profiles",
    "task_sets"
  ],
  "title": "CatalogConfig",
  "type": "object"
}
