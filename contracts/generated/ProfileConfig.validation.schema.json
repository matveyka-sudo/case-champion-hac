{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Budget",
      "type": "object"
    },
    "TripRules": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_access_walk_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Access Walk Minutes"
        },
        "max_one_way_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max One Way Minutes"
        },
        "max_transfers": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Transfers"
        },
        "require_step_free": {
          "title": "Require Step Free",
          "type": "boolean"
        }
      },
      "required": [
        "max_one_way_minutes",
        "max_transfers",
        "max_access_walk_minutes",
        "budget",
        "require_step_free"
      ],
      "title": "TripRules",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumption_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Assumption Ids",
      "type": "array"
    },
    "basis": {
      "enum": [
        "scenario",
        "verified"
      ],
      "title": "Basis",
      "type": "string"
    },
    "destination_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Destination Ids",
      "type": "array"
    },
    "end_date": {
      "format": "date",
      "title": "End Date",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "half_life_minutes": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Half Life Minutes"
    },
    "horizon_hours": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Horizon Hours"
    },
    "metric_kind": {
      "enum": [
        "activity_feasibility",
        "time_decay"
      ],
      "title": "Metric Kind",
      "type": "string"
    },
    "modes": {
      "items": {
        "enum": [
          "rail",
          "bus",
          "walk"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Modes",
      "type": "array"
    },
    "profile_id": {
      "enum": [
        "regular",
        "medical",
        "intercity"
      ],
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "exclusiveMinimum": 0,
      "title": "Profile Version",
      "type": "integer"
    },
    "rules": {
      "$ref": "#/$defs/TripRules"
    },
    "service_type_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Service Type Ids",
      "type": "array"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    },
    "start_times": {
      "items": {
        "format": "time",
        "type": "string"
      },
      "minItems": 1,
      "title": "Start Times",
      "type": "array"
    },
    "study_area_id": {
      "minLength": 1,
      "title": "Study Area Id",
      "type": "string"
    },
    "study_area_version": {
      "exclusiveMinimum": 0,
      "title": "Study Area Version",
      "type": "integer"
    },
    "timezone": {
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    },
    "weighting": {
      "enum": [
        "uniform",
        "explicit"
      ],
      "title": "Weighting",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "study_area_id",
    "study_area_version",
    "metric_kind",
    "start_date",
    "end_date",
    "timezone",
    "start_times",
    "destination_ids",
    "service_type_ids",
    "modes",
    "rules",
    "weighting",
    "basis",
    "assumption_ids",
    "evidence_ids",
    "half_life_minutes",
    "horizon_hours"
  ],
  "title": "ProfileConfig",
  "type": "object"
}
