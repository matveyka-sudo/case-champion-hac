{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Budget",
      "type": "object"
    },
    "TaskCase": {
      "additionalProperties": false,
      "properties": {
        "activity_basis": {
          "anyOf": [
            {
              "enum": [
                "scenario",
                "verified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Basis"
        },
        "activity_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity End"
        },
        "activity_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Start"
        },
        "arrival_buffer_max_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Buffer Max Minutes"
        },
        "arrival_buffer_min_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Buffer Min Minutes"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "destination_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Id"
        },
        "earliest_departure": {
          "format": "date-time",
          "title": "Earliest Departure",
          "type": "string"
        },
        "max_access_walk_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Access Walk Minutes"
        },
        "max_one_way_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max One Way Minutes"
        },
        "max_transfers": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Transfers"
        },
        "origin_id": {
          "minLength": 1,
          "title": "Origin Id",
          "type": "string"
        },
        "profile_id": {
          "enum": [
            "regular",
            "medical",
            "intercity"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "require_step_free": {
          "title": "Require Step Free",
          "type": "boolean"
        },
        "return_by": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return By"
        },
        "service_date": {
          "format": "date",
          "title": "Service Date",
          "type": "string"
        },
        "service_type_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Type Id"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "max_one_way_minutes",
        "max_transfers",
        "max_access_walk_minutes",
        "budget",
        "require_step_free",
        "profile_id",
        "origin_id",
        "service_date",
        "earliest_departure",
        "case_id",
        "weight"
      ],
      "title": "TaskCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumption_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Assumption Ids",
      "type": "array"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/TaskCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "end_date": {
      "format": "date",
      "title": "End Date",
      "type": "string"
    },
    "generation_rules_hash": {
      "minLength": 1,
      "title": "Generation Rules Hash",
      "type": "string"
    },
    "profile_id": {
      "enum": [
        "regular",
        "medical",
        "intercity"
      ],
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "exclusiveMinimum": 0,
      "title": "Profile Version",
      "type": "integer"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    },
    "task_set_hash": {
      "minLength": 1,
      "title": "Task Set Hash",
      "type": "string"
    }
  },
  "required": [
    "task_set_hash",
    "generation_rules_hash",
    "profile_id",
    "profile_version",
    "start_date",
    "end_date",
    "cases",
    "assumption_ids"
  ],
  "title": "TaskSet",
  "type": "object"
}
