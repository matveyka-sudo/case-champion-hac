{
  "$defs": {
    "AnalysisPreset": {
      "additionalProperties": false,
      "description": "One exact versioned request supported by a registered server profile.",
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "preset_id": {
          "minLength": 1,
          "title": "Preset Id",
          "type": "string"
        },
        "request": {
          "discriminator": {
            "mapping": {
              "intercity_cargo": "#/$defs/IntercityCargoRequest",
              "intercity_passenger": "#/$defs/IntercityPassengerRequest",
              "urban_cargo": "#/$defs/UrbanCargoRequest",
              "urban_passenger": "#/$defs/UrbanPassengerRequest"
            },
            "propertyName": "analysis_kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UrbanPassengerRequest"
            },
            {
              "$ref": "#/$defs/IntercityPassengerRequest"
            },
            {
              "$ref": "#/$defs/UrbanCargoRequest"
            },
            {
              "$ref": "#/$defs/IntercityCargoRequest"
            }
          ],
          "title": "Request"
        },
        "scenario_operations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Scenario Operations",
          "type": "array"
        }
      },
      "required": [
        "preset_id",
        "label",
        "request"
      ],
      "title": "AnalysisPreset",
      "type": "object"
    },
    "AreaOption": {
      "additionalProperties": false,
      "properties": {
        "area_id": {
          "minLength": 1,
          "title": "Area Id",
          "type": "string"
        },
        "city_id": {
          "minLength": 1,
          "title": "City Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
