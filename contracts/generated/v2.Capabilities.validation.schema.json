        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "temperature_requirements": {
          "$ref": "#/$defs/TemperatureRequirements"
        },
        "urgency": {
          "enum": [
            "urgent",
            "ordinary",
            "nonurgent"
          ],
