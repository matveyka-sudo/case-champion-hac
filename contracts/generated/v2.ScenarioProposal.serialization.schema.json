{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "section": {
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "url",
        "retrieved_at",
        "observed_at",
        "section"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FixedParameters": {
      "additionalProperties": false,
      "properties": {
        "demand_evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Demand Evidence",
          "type": "array"
        },
        "resource_constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Resource Constraints",
          "type": "array"
        },
        "resource_evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Resource Evidence",
          "type": "array"
        },
        "service_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Service Ids",
          "type": "array"
        },
        "shift_seconds": {
          "title": "Shift Seconds",
          "type": "integer"
        },
        "turnaround_evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Turnaround Evidence",
          "type": "array"
        }
      },
      "required": [
        "service_ids",
        "shift_seconds",
        "demand_evidence",
        "resource_evidence",
        "turnaround_evidence",
        "resource_constraints"
      ],
      "title": "FixedParameters",
      "type": "object"
    },
    "VersionRefs": {
      "additionalProperties": false,
      "properties": {
        "calendar_version": {
          "minLength": 1,
          "title": "Calendar Version",
          "type": "string"
        },
        "code_version": {
          "minLength": 1,
          "title": "Code Version",
          "type": "string"
        },
        "config_hash": {
          "minLength": 1,
          "title": "Config Hash",
          "type": "string"
        },
        "graph_version": {
          "minLength": 1,
          "title": "Graph Version",
          "type": "string"
        },
        "methodology_version": {
          "const": "a2-methodology-v3",
          "title": "Methodology Version",
          "type": "string"
        },
        "population_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Population Version"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "graph_version",
        "calendar_version",
        "population_version",
        "methodology_version",
        "config_hash",
        "code_version"
      ],
      "title": "VersionRefs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "baseline_analysis_id": {
      "minLength": 1,
      "title": "Baseline Analysis Id",
      "type": "string"
    },
    "baseline_result_hash": {
      "minLength": 1,
      "title": "Baseline Result Hash",
      "type": "string"
    },
    "editable_local_graph": {
      "title": "Editable Local Graph",
      "type": "boolean"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "feasibility": {
      "enum": [
        "verified",
        "unverified"
      ],
      "title": "Feasibility",
      "type": "string"
    },
    "fixed_parameters": {
      "$ref": "#/$defs/FixedParameters"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "operation_type": {
      "enum": [
        "coordinate_transfer",
        "additional_departure"
      ],
      "title": "Operation Type",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "proposed",
      "title": "Status",
      "type": "string"
    },
    "template_id": {
      "minLength": 1,
      "title": "Template Id",
      "type": "string"
    },
    "versions": {
      "$ref": "#/$defs/VersionRefs"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "baseline_analysis_id",
    "template_id",
    "operation_type",
    "fixed_parameters",
    "evidence_refs",
    "assumptions",
    "status",
    "feasibility",
    "versions",
    "baseline_result_hash",
    "editable_local_graph",
    "limitations"
  ],
  "title": "ScenarioProposal",
  "type": "object"
}
