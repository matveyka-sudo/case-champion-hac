        },
        "urgency": {
          "enum": [
            "urgent",
            "ordinary",
            "nonurgent"
          ],
          "title": "Urgency",
          "type": "string"
        },
        "vehicle_constraints": {
          "$ref": "#/$defs/VehicleConstraints"
        }
      },
      "required": [
        "profile_id",
        "kind",
        "food_class",
        "urgency",
        "temperature_requirements",
        "handling_requirements",
        "vehicle_constraints"
