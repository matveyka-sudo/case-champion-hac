{
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "properties": {
        "east": {
          "maximum": 180,
          "minimum": -180,
          "title": "East",
          "type": "number"
        },
        "north": {
          "maximum": 90,
          "minimum": -90,
          "title": "North",
          "type": "number"
        },
        "south": {
          "maximum": 90,
          "minimum": -90,
          "title": "South",
          "type": "number"
        },
        "west": {
          "maximum": 180,
          "minimum": -180,
          "title": "West",
          "type": "number"
        }
      },
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "GeometryRef": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "geometry_id": {
          "minLength": 1,
          "title": "Geometry Id",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_refs",
        "geometry_id",
        "version"
      ],
      "title": "GeometryRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "calibration_method": {
      "minLength": 1,
      "title": "Calibration Method",
      "type": "string"
    },
    "edge_id": {
      "minLength": 1,
      "title": "Edge Id",
      "type": "string"
    },
    "from_node_id": {
      "minLength": 1,
      "title": "From Node Id",
      "type": "string"
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeometryRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "length_m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Length M"
    },
    "mode": {
      "enum": [
        "walk",
        "public_transport",
        "private_car",
        "road",
        "rail",
        "air",
        "water",
        "mixed",
        "pipeline"
      ],
      "title": "Mode",
      "type": "string"
    },
    "running_time_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Running Time Seconds"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Refs",
      "type": "array"
    },
    "to_node_id": {
      "minLength": 1,
      "title": "To Node Id",
      "type": "string"
    }
  },
  "required": [
    "source_refs",
    "edge_id",
    "from_node_id",
    "to_node_id",
    "mode",
    "length_m",
    "running_time_seconds",
    "calibration_method",
    "geometry"
  ],
  "title": "ReferenceEdge",
  "type": "object"
}
